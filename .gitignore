# Ambiente e caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Segredos: só o .env.example é versionado
.env

# Dados (brutos, processados e lakehouse) não são versionados, com duas exceções: as cópias
# congeladas do ONI/MEI (a NOAA revisa as séries) e do arquivo da Conab (janela móvel de 12 meses)
data/*
!data/raw/
data/raw/*
!data/raw/noaa/
!data/raw/conab/

# Notebooks: a fonte é o .py (percent); .ipynb gerados pelo jupytext são derivados
notebooks/*.ipynb

# Outputs pesados (figuras PNG/SVG e tabelas CSV pequenas são versionadas)
outputs/**/*.parquet
outputs/**/*.duckdb
outputs/**/*.pkl
outputs/**/*.nc
outputs/**/*.zip

# Logs
*.log

# Metadados do Windows/WSL
*:Zone.Identifier
*.Zone.Identifier
